{
  "name": "kalender-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API kalender nasional Indonesia: hari libur nasional, cuti bersama, hari peringatan",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build:server && node build/server.js",
    "start": "node build/server.js",
    "build": "npm run typecheck && npm run test && npm run build:static && npm run build:static-page && npm run build:server",
    "build:static": "node scripts/build-static.ts",
    "build:server": "node scripts/build-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:static-page": "node --experimental-strip-types scripts/build-static-page.ts"
  },
  "dependencies": {
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
