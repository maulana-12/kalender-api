# Salin ke .env lalu isi. JANGAN commit .env yang sudah berisi key asli.
# Cloudflare Worker: jangan pakai .env, set lewat `wrangler secret put API_KEY`.

# Wajib. Endpoint /api/* akan menolak request tanpa key ini.
API_KEY=ganti-dengan-kemu-acak-panjang

# Opsional. Default 3001. Kalau EADDRINUSE, ganti ke port lain yang kosong.
PORT=3001
